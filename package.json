{
  "name": "ember-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && firebase deploy --only hosting:ember --project planning-with-ai-cb2ae",
    "format": "prettier --write src tests scripts *.json *.js index.html public/manifest.webmanifest .vscode README.md"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "firebase": "^12.0.0",
    "chart.js": "^4.4.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "prettier": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
