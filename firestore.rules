rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Preserved verbatim from this project's previous rules. The expiry is unchanged.
  match /{document=**} { allow read, write: if request.auth != null && request.time < timestamp.date(2026, 7, 23); }
  // Ember uses its own namespace. Existing project rules must be merged, not replaced.
  function signedIn() { return request.auth != null; }
  function self(id) { return signedIn() && request.auth.uid == id; }
  match /ember/v1/codes/{code} {
   allow get: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid && code.matches('LOCK-[A-Z2-9]{6}') && getAfter(/databases/$(database)/documents/ember/v1/profiles/$(request.auth.uid)).data.code == code;
  }
  match /ember/v1/profiles/{id} {
   allow get: if signedIn();
   allow create, update: if self(id) && request.resource.data.keys().hasOnly(['name','code','ghosts','league','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 24 && request.resource.data.ghosts is list && request.resource.data.ghosts.size() <= 30 && request.resource.data.league.week is string && request.resource.data.league.points is number && request.resource.data.league.points >= 0 && request.resource.data.league.points <= 10000 && getAfter(/databases/$(database)/documents/ember/v1/codes/$(request.resource.data.code)).data.uid == id;
  }
  match /ember/v1/rooms/{code} {
   function room() { return get(/databases/$(database)/documents/ember/v1/rooms/$(code)).data; }
   function member() { return exists(/databases/$(database)/documents/ember/v1/rooms/$(code)/members/$(request.auth.uid)); }
   allow get: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['owner','mode','subject','planned','target','memberCount','startedAt','createdAt']) && request.resource.data.owner == request.auth.uid && request.resource.data.mode in ['race','coop','teams'] && request.resource.data.subject is string && request.resource.data.subject.size() <= 30 && request.resource.data.planned in [25,45,60] && request.resource.data.target is number && request.resource.data.target >= 0 && request.resource.data.target <= 240 && request.resource.data.memberCount == 0 && request.resource.data.startedAt == null;
   allow update: if signedIn() && ((resource.data.owner == request.auth.uid && resource.data.startedAt == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startedAt']) && request.resource.data.startedAt == request.time)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) && request.resource.data.memberCount >= 0 && request.resource.data.memberCount <= 8 &&
     ((resource.data.startedAt == null && !member() && request.resource.data.memberCount == resource.data.memberCount + 1 && existsAfter(/databases/$(database)/documents/ember/v1/rooms/$(code)/members/$(request.auth.uid)))
      || (member() && request.resource.data.memberCount == resource.data.memberCount - 1 && !existsAfter(/databases/$(database)/documents/ember/v1/rooms/$(code)/members/$(request.auth.uid))))));
   match /members/{id} {
    allow get: if self(id) || (signedIn() && member());
    allow list: if signedIn() && member();
    allow create: if self(id) && room().startedAt == null && getAfter(/databases/$(database)/documents/ember/v1/rooms/$(code)).data.memberCount == room().memberCount + 1 && request.resource.data.keys().hasOnly(['name','team','score','done','joinedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 24 && request.resource.data.team in ['A','B'] && request.resource.data.score == 0 && request.resource.data.done == false;
    allow update: if self(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score','done']) && request.resource.data.score is number && request.resource.data.score >= resource.data.score && request.resource.data.score <= room().planned * 4 && request.resource.data.done is bool;
    allow delete: if self(id) && getAfter(/databases/$(database)/documents/ember/v1/rooms/$(code)).data.memberCount == room().memberCount - 1;
   }
  }
  match /ember/v1/pacts/{code} {
   function pact() { return get(/databases/$(database)/documents/ember/v1/pacts/$(code)).data; }
   function inPact() { return signedIn() && request.auth.uid in pact().memberIds; }
   allow get: if signedIn();
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['owner','memberIds','names','goal','createdAt']) && request.resource.data.owner == request.auth.uid && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.names.keys().hasOnly([request.auth.uid]) && request.resource.data.names[request.auth.uid] is string && request.resource.data.names[request.auth.uid].size() <= 24 && request.resource.data.goal in ['daily','weekly'];
   allow update: if signedIn() && resource.data.memberIds.size() == 1 && !(request.auth.uid in resource.data.memberIds) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','names']) && request.resource.data.memberIds == [resource.data.owner, request.auth.uid] && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]) && request.resource.data.names[request.auth.uid] is string && request.resource.data.names[request.auth.uid].size() <= 24;
   match /checkins/{id} {
    allow read: if inPact();
    allow create, update: if inPact() && request.resource.data.keys().hasOnly(['uid','day','minutes','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && id == request.auth.uid + '-' + request.resource.data.day && request.resource.data.minutes is number && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 10000 && (pact().goal == 'daily' || request.resource.data.minutes >= 180);
   }
   match /covers/{id} {
    allow read: if inPact();
    allow create: if inPact() && request.resource.data.keys().hasOnly(['usedBy','coveredUid','day','week','createdAt']) && request.resource.data.usedBy == request.auth.uid && request.resource.data.coveredUid in pact().memberIds && request.resource.data.coveredUid != request.auth.uid && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.week is string && request.resource.data.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && id == request.auth.uid + '-' + request.resource.data.week;
   }
  }
 }
}
